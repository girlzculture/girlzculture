NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GUEST_BOOKING_LINK_SECRET=
ADMIN_EMAIL_DOMAIN=girlzculture.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SITE_HOST=girlzculture.com
NEXT_PUBLIC_SALON_DASHBOARD_HOST=dashboard.girlzculture.com
NEXT_PUBLIC_ADMIN_HOST=mothership.girlzculture.com
# Keep false until both Netlify aliases and TLS certificates are ready.
DASHBOARD_SUBDOMAINS_ENABLED=false
DASHBOARD_SUBDOMAINS_PILOT_READY=false
NEXT_PUBLIC_ADMIN_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_ADMIN_ABSOLUTE_SESSION_HOURS=8

# Stripe test mode only. Never expose STRIPE_SECRET_KEY or the webhook secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Canonical monthly Price IDs for every new subscription checkout or plan change.
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_GROWTH=price_
STRIPE_PRICE_PREMIUM=price_
# Fail closed until the complete paid-benefit readiness review is approved.
# This is server-only and must never be exposed through NEXT_PUBLIC_*.
SUBSCRIPTION_SALES_ENABLED=false
# Legacy identity only: retain while existing subscriptions/webhook history can
# reference these Prices. New Starter checkout never reads the legacy Basic ID.
STRIPE_BASIC_PRICE_ID=price_
STRIPE_GROWTH_PRICE_ID=price_
STRIPE_PREMIUM_PRICE_ID=price_
# Enable only after Stripe Tax registrations and product tax behavior are configured.
STRIPE_TAX_ENABLED=false
INTERNAL_API_SECRET=replace-with-a-long-random-server-only-value
PASSWORD_RESET_SECRET=replace-with-another-long-random-server-only-value
MFA_CODE_SECRET=replace-with-at-least-32-random-server-only-characters
ADMIN_MFA_MODE=every_login
MFA_CHALLENGE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_RESEND_COOLDOWN_SECONDS=60

# Web Push. Generate once with: node scripts/generate-vapid.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@girlzculture.com
COMPLAINT_RATE_LIMIT_SALT=replace-with-a-long-random-server-only-value

# Transactional email: https://resend.com
RESEND_API_KEY=
EMAIL_FROM_SECURITY=Girlz Culture Security <noreply@notifications.girlzculture.com>
EMAIL_FROM_BOOKINGS=Girlz Culture Bookings <bookings@notifications.girlzculture.com>
EMAIL_FROM_ACCOUNT=Girlz Culture <hello@notifications.girlzculture.com>
EMAIL_FROM_SUPPORT=Girlz Culture Support <support@notifications.girlzculture.com>

# Booking text messages: https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Official social channels. Unconfigured links stay hidden from /social.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Google Cloud browser key: enable Maps JavaScript API and Places API (New).
# Restrict by production/preview website referrers and restrict to those APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional provider-neutral AI assistance. Core search, booking, support, and
# publishing work without these values. Keep every provider key server-side.
AI_APPROVED_PROVIDERS=test,openai
AI_APPROVED_MODELS={"openai":["gpt-5.4-nano"]}
OPENAI_API_KEY=
# Conservative launch cost rates used only for the Engine budget ledger. Update
# these when the selected provider/model price changes; they are USD per 1M tokens.
OPENAI_CONCIERGE_INPUT_USD_PER_MILLION=1
OPENAI_CONCIERGE_OUTPUT_USD_PER_MILLION=4
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Authorizes scheduled cleanup of abandoned staged media. Generate a long,
# random server-only value and use the same value for scheduled function calls.
CRON_SECRET=

# Optional controlled transcoding worker used for incompatible Trending Video
  # Cloudinary server-side video processing. Create one cloud, copy the cloud
  # name/API key/API secret from its API Keys page, and keep the secret
  # server-only. Engine > Integrations provides a safe connection test.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
  # Optional private-transcoder fallback. Cloudinary is the supported launch
  # provider, but this contract remains available for a future dedicated worker.
MEDIA_TRANSCODE_ENDPOINT=
MEDIA_TRANSCODE_TOKEN=

# Google Cloud server key: enable Geocoding API only. Keep server-side and
# restrict to Geocoding API plus the deployment's stable outbound IP where available.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional fallback outside Netlify Edge. Netlify deployments use context.geo
# automatically and do not require these values. The URL may contain {ip}.
IP_GEOLOCATION_PROVIDER_URL=
IP_GEOLOCATION_API_KEY=
